# Clodds — AI Trading Terminal (Railway deployment)
# Only ANTHROPIC_API_KEY is required. WebChat works immediately with no other config.

# =============================================================================
# REQUIRED
# =============================================================================

# Anthropic API Key — powers the AI. Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# GATEWAY (Railway injects PORT; CLODDS_PORT is set in the Dockerfile)
# =============================================================================

# Secret token for gateway API access (optional but recommended for public deploys)
CLODDS_TOKEN=

# Optional auth token for the built-in WebChat client
WEBCHAT_TOKEN=

# =============================================================================
# MESSAGING CHANNELS (optional — pick any)
# =============================================================================

# Telegram (recommended — easiest): token from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Discord: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=

# Slack: https://api.slack.com/apps
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# =============================================================================
# TRADING CREDENTIALS (optional — start in dry-run mode)
# =============================================================================

# Polymarket
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_PRIVATE_KEY=
POLY_FUNDER_ADDRESS=

# Kalshi
KALSHI_API_KEY=
KALSHI_API_SECRET=

# Hyperliquid (perpetuals)
HYPERLIQUID_WALLET=
HYPERLIQUID_PRIVATE_KEY=

# Binance Futures
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Solana DeFi
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# EVM DeFi
EVM_PRIVATE_KEY=
ALCHEMY_API_KEY=